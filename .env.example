# ==========================================
# 🌐 SERVER & CORE CONFIGURATION
# ==========================================
PORT=5000
NODE_ENV=development
FRONTEND_URL="http://localhost:3000,https://hotel-pms-mithiias.netlify.app"

# ==========================================
# 🗄️ DATABASE & SECURITY
# ==========================================
DATABASE_URL="mysql://username:password@localhost:3306/hotel_db"
JWT_SECRET="your_jwt_secret_here"
JWT_EXPIRES_IN="7d"
DB_ENCRYPTION_KEY="your_db_encryption_key_here"

# ==========================================
# 🤖 AI ENGINE (OpenAI GPT-4o-mini)
# ==========================================
OPENAI_API_KEY="your_openai_api_key"
OPENAI_MODEL="gpt-4o-mini"

# ==========================================
# 💬 WHATSAPP BUSINESS API (Meta Cloud API)
# ==========================================
META_ACCESS_TOKEN=""
META_APP_SECRET=""
META_PHONE_NUMBER_ID=""
META_APP_ID=""
META_CONFIG_ID=""
META_WABA_ID=""
META_WEBHOOK_VERIFY_TOKEN=""

# Compatibility Aliases
WHATSAPP_TOKEN=""
WHATSAPP_APP_SECRET=""
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_NUMBER=""
WABA_ID=""
VERIFY_TOKEN=""

# ==========================================
# 📧 GOOGLE GMAIL OAUTH 2.0 (Guest Email)
# ==========================================
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_REDIRECT_URI="http://localhost:5000/api/email/oauth/google/callback"

# ==========================================
# 📧 MICROSOFT 365 / OUTLOOK OAUTH 2.0 (Guest Email)
# ==========================================
MICROSOFT_CLIENT_ID=""
MICROSOFT_CLIENT_SECRET=""
MICROSOFT_TENANT_ID="common"
MICROSOFT_REDIRECT_URI="http://localhost:5000/api/email/oauth/microsoft/callback"
MICROSOFT_GRAPH_BASE_URL="https://graph.microsoft.com/v1.0"

# ==========================================
# 🏨 PMS / MEWS INTEGRATION
# ==========================================
MEWS_CLIENT_TOKEN=""
MEWS_ACCESS_TOKEN=""
MEWS_API_URL="https://api.mews-demo.com/api/connector/v1"

# ==========================================
# ✉️ BREVO (Staff Transactional Email)
# ==========================================
BREVO_API_KEY=""
BREVO_SENDER_EMAIL="reception@example.com"
BREVO_SENDER_NAME="Hotel Operations"
